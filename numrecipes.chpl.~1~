// -----------------------------------------------------------------------------
// --> ludcmp: Given a matrix a[1..n,1..n], this routine replaces it by the LU
// decomposition of a rowwise permutation of itself. a is input. a is output,
// arranged as in equation (2.3.14) above; indx[1..n] is an output vector that
// records the row permutation effected by the partial pivoting; d is output as
// ±1 depending on whether the number of row interchanges was even or odd,
// respectively. This routine is used in combination with lubksb to solve linear
// equations or invert a matrix.
// -----------------------------------------------------------------------------
proc ludcmp(
   ref aa: [] real,
   ref aindx: [] int,
   out d: real
   ) where ((aa.rank == 2) && (aindx.rank == 1)) {
   // --------------------------------------------------------------------------
   // Check for consistent sizes.
   // --------------------------------------------------------------------------
   const TINY = 1.0e-20;
   const n = aindx.size;
   assert (aa.shape == (n,n));
   var imax: int;
   var vv: [1..n] real;       // vv stores the implicit scaling of each row
   d = 1.0;                   // no row interchanges yet
   // --------------------------------------------------------------------------
   // Loop over rows to get the implicit scaling information.
   // --------------------------------------------------------------------------
   for i in 1..n do { 
      var big = 0.0;
      for j in 1..n do {
         var temp = abs(a[i,j]);
         if temp > big then {
            big = temp;
         }
      // -----------------------------------------------------------------------
      // No nonzero largest element.
      // -----------------------------------------------------------------------
         if (big == 0.0) then {
            halt("Singular matrix in routine ludcmp");
         }
      }
      vv[i] = 1.0 / big;      // save the scaling
   }
   // --------------------------------------------------------------------------
   // This is the loop over columns of Crout’s method.
   // --------------------------------------------------------------------------
   for j in 1..n do {
      // -----------------------------------------------------------------------
      // This is equation (2.3.12) except for i == j.
      // -----------------------------------------------------------------------
      for i in 1..n do {
         var sum = a[i,j];
         for k in 1..i-1 do {
            sum -= a[i,k] * a[k,j];
         }
         a[i,j] = sum;
      }
      // -----------------------------------------------------------------------
      // Initialize for the search for largest pivot element.
      // -----------------------------------------------------------------------
      var big = 0.0;
      // -----------------------------------------------------------------------
      // This is i = j of equation (2.3.12) and i = j +1 . . . N of equation
      // (2.3.13).
      // -----------------------------------------------------------------------
      for i in j..n do {
         var sum = a[i,j];
         for k in 1..j-1 do { 
            sum -= a[i,k] * a[k,j];
         }
         a[i,j] = sum;
         var dum = vv[i]*abs(sum);
         if (dum >= big) then {
            big = dum;
            imax = i;
         }
      }
      // -----------------------------------------------------------------------
      // Do we need to interchange rows?
      // -----------------------------------------------------------------------
      if (j != imax) then {
         // --------------------------------------------------------------------
         // Yes, do so ...
         // --------------------------------------------------------------------
         for k in 1..n do {
            a[imax,k] <=> a[j,k];
         }
         d = -d;              // ... and change teh parity of d
         vv[imax] = vv[j];    // also interchange the scale factor
      }
      indx[j] = imax;
      // -----------------------------------------------------------------------
      // If the pivot element is zero the matrix is singular (at least to the
      // precision of the algorithm). For some applications on singular
      // matrices, it is desirable to substitute TINY for zero.
      // -----------------------------------------------------------------------
      if ( a[j,j] == 0.0 ) then a[j,j] = TINY;
      // -----------------------------------------------------------------------
      // Now, finally, divide by the pivot element.
      // -----------------------------------------------------------------------
      if (j != n) then {
         var dum = 1.0 / a[j,j];
         for i in j+1..n do {
            a[i,j] *= dum;
         }
      }
      // -----------------------------------------------------------------------
      // Go back for the next column in the reduction.
      // -----------------------------------------------------------------------
   }
}

// -----------------------------------------------------------------------------
// --> lubksb: solves the set of n linear equations A·X = B. Here a[1..n,1..n]
// is input, not as the matrix A but rather as its LU decomposition, determined
// by the routine ludcmp. indx[1..n] is input as the permutation vector returned
// by ludcmp. b[1..n] is input as the right-hand side vector B, and returns with
// the solution vector X. a, and indx are not modified by this routine and can
// be left in place for successive calls with different right-hand sides b. This
// routine takes into account the possibility that b will begin with many zero
// elements, so it is efficient for use in matrix inversion.
// -----------------------------------------------------------------------------

proc lubksb(
   const ref aa: [] real,
   const ref aindx: [] int,
   ref ab: [] real
   )
   where aa.rank == 2 && aindx.rank == 1 && ab.rank == 1 {
   // --------------------------------------------------------------------------
   // Check for consistent sizes.
   // --------------------------------------------------------------------------
   const n = aindx.size;
   assert (aa.shape == (n,n));
   assert (ab.size == n);
   // --------------------------------------------------------------------------
   //   Reindex arrays.
   // --------------------------------------------------------------------------
   ref a = aa.reindex({1..n,1..n});
   ref indx = aindx.reindex({1..n});
   ref b = ab.reindex({1..n});
   var sum: real;
   var ii = 0;
   for i in 1..n do {
      var ip = indx[i];
      sum = b[ip];
      b[ip] = b[i];
      if (ii) then {
         for j in ii..i-1 do {
            sum -= a[i,j] * b[j];
         }
      }
      else if (sum != 0.0) then {
         ii = i;
      }
      b[i] = sum;
   }
   for i in 1..n by -1 do {
      sum = b[i];
      for j in i+1..n do {
         sum -= a[i,j] * b[j];
      }
      b[i] = sum / a[i,i];
   }
}
